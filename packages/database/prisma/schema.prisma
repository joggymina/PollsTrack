generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model County {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  constituencies      Constituency[]
  organizations       Organization[]
  positionAdminScopes PositionAdminScope[]
}

model Constituency {
  id                  String               @id @default(cuid())
  code                String
  name                String
  countyId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  county              County               @relation(fields: [countyId], references: [id])
  organizations       Organization[]
  positionAdminScopes PositionAdminScope[]
  wards               Ward[]

  @@unique([countyId, code])
  @@index([countyId])
}

model Ward {
  id                  String               @id @default(cuid())
  code                String
  name                String
  constituencyId      String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizations       Organization[]
  pollingStations     PollingStation[]
  positionAdminScopes PositionAdminScope[]
  constituency        Constituency         @relation(fields: [constituencyId], references: [id])

  @@unique([constituencyId, code])
  @@index([constituencyId])
}

model PollingStation {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  wardId           String
  registeredVoters Int?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  agents           AgentAssignment[]
  ward             Ward              @relation(fields: [wardId], references: [id])
  results          StationResult[]

  @@index([wardId])
}

model Organization {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  code              String?         @unique
  primaryLevel      OrgPrimaryLevel @default(NATIONAL)
  countyId          String?
  constituencyId    String?
  wardId            String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  publicViewEnabled Boolean         @default(false)
  publicShareToken  String?         @unique(where: raw("(\"publicShareToken\" IS NOT NULL)"))
  elections         Election[]
  constituency      Constituency?   @relation(fields: [constituencyId], references: [id])
  county            County?         @relation(fields: [countyId], references: [id])
  ward              Ward?           @relation(fields: [wardId], references: [id])
  users             User[]

  @@index([countyId])
  @@index([constituencyId])
  @@index([wardId])
}

model User {
  id                  String               @id @default(cuid())
  phone               String               @unique
  name                String
  role                UserRole             @default(AGENT)
  isActive            Boolean              @default(true)
  countyId            String?
  constituencyId      String?
  wardId              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdById         String?
  organizationId      String?
  assignmentsCreated  AgentAssignment[]    @relation("AssignmentsCreated")
  agentAssignments    AgentAssignment[]    @relation("AgentAssignments")
  auditLogs           AuditLog[]
  positionAdminScopes PositionAdminScope[]
  submittedResults    StationResult[]
  createdBy           User?                @relation("UsersCreated", fields: [createdById], references: [id])
  createdUsers        User[]               @relation("UsersCreated")
  organization        Organization?        @relation(fields: [organizationId], references: [id])

  @@index([createdById])
  @@index([organizationId])
}

model PositionAdminScope {
  id             String          @id @default(cuid())
  userId         String
  raceId         String
  level          AdminScopeLevel
  countyId       String?
  constituencyId String?
  wardId         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  constituency   Constituency?   @relation(fields: [constituencyId], references: [id])
  county         County?         @relation(fields: [countyId], references: [id])
  race           Race            @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ward           Ward?           @relation(fields: [wardId], references: [id])

  @@unique([userId, raceId, level, countyId, constituencyId, wardId])
  @@index([userId])
  @@index([raceId])
  @@index([countyId])
  @@index([constituencyId])
  @@index([wardId])
}

model AgentAssignment {
  id               String         @id @default(cuid())
  userId           String
  pollingStationId String
  createdAt        DateTime       @default(now())
  assignedById     String?
  assignedBy       User?          @relation("AssignmentsCreated", fields: [assignedById], references: [id])
  pollingStation   PollingStation @relation(fields: [pollingStationId], references: [id])
  user             User           @relation("AgentAssignments", fields: [userId], references: [id])

  @@unique([userId, pollingStationId])
  @@index([assignedById])
}

model Election {
  id             String        @id @default(cuid())
  name           String
  type           String
  status         String        @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  races          Race[]

  @@index([organizationId])
}

model Race {
  id                  String               @id @default(cuid())
  electionId          String
  position            String
  scope               String
  countyId            String?
  constituencyId      String?
  wardId              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  candidates          Candidate[]
  positionAdminScopes PositionAdminScope[]
  election            Election             @relation(fields: [electionId], references: [id])
  results             StationResult[]
}

model Candidate {
  id        String       @id @default(cuid())
  raceId    String
  name      String
  code      String?
  party     String?
  photoUrl  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  race      Race         @relation(fields: [raceId], references: [id])
  votes     ResultVote[]

  @@unique([raceId, code], where: raw("(code IS NOT NULL)"))
}

model StationResult {
  id                String         @id @default(cuid())
  pollingStationId  String
  raceId            String
  submittedById     String
  totalRegistered   Int?
  totalVoted        Int?
  rejectedBallots   Int            @default(0)
  formPhotoUrl      String?
  formPhotoHash     String?
  clientSubmittedAt DateTime
  serverReceivedAt  DateTime       @default(now())
  isOffline         Boolean        @default(false)
  deviceInfo        Json?
  status            String         @default("SUBMITTED")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  votes             ResultVote[]
  pollingStation    PollingStation @relation(fields: [pollingStationId], references: [id])
  race              Race           @relation(fields: [raceId], references: [id])
  submittedBy       User           @relation(fields: [submittedById], references: [id])

  @@unique([pollingStationId, raceId, submittedById])
  @@index([pollingStationId, raceId])
  @@index([pollingStationId])
  @@index([raceId])
  @@index([submittedById])
}

model ResultVote {
  id              String        @id @default(cuid())
  stationResultId String
  candidateId     String
  votes           Int
  candidate       Candidate     @relation(fields: [candidateId], references: [id])
  stationResult   StationResult @relation(fields: [stationResultId], references: [id], onDelete: Cascade)

  @@unique([stationResultId, candidateId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

enum OrgPrimaryLevel {
  NATIONAL
  COUNTY
  CONSTITUENCY
  WARD
}

enum UserRole {
  SUPER_ADMIN
  NATIONAL_VIEWER
  COUNTY_VIEWER
  CONSTITUENCY_VIEWER
  WARD_VIEWER
  AGENT
  POSITION_ADMIN
}

enum AdminScopeLevel {
  NATIONAL
  COUNTY
  CONSTITUENCY
  WARD
}
